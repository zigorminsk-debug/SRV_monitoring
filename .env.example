# Сервер слушает все интерфейсы. Публикуйте его только за HTTPS reverse proxy.
APP_HOST=0.0.0.0
APP_PORT=8765
REQUIRE_HTTPS=true
SECURE_COOKIES=true
# Доверять только локальному reverse proxy. Не ставьте * на публичном интерфейсе.
FORWARDED_ALLOW_IPS=127.0.0.1

# Задайте собственный длинный пароль. Если оставить пустым, сервер один раз
# создаст случайный пароль в data/initial-admin-password.txt.
ADMIN_USER=admin
ADMIN_PASSWORD=

# По умолчанию ключи создаются в MONITORING_DATA_DIR и остаются локально.
# Храните их резервную копию: без encryption.key нельзя расшифровать конфиги источников.
MONITORING_DATA_DIR=./data
# APP_SESSION_SECRET=
# MONITORING_ENCRYPTION_KEY=

# Для встроенного HTTPS укажите оба файла; иначе используйте IIS/Caddy/Nginx reverse proxy.
# SSL_CERTFILE=C:\certs\monitoring.crt
# SSL_KEYFILE=C:\certs\monitoring.key
# SECURE_COOKIES=true

# Для production укажите DNS-имя/IP, по которым открывается панель.
# PUBLIC_BASE_URL=https://monitor.example.com
# TRUSTED_HOSTS=monitor.example.com,203.0.113.10
# По умолчанию разрешены все Host — замените это значение перед публикацией.
TRUSTED_HOSTS=*
MAX_REQUEST_BYTES=262144
